    <decisions>
        <name>Is_Newly_Overdue</name>
        <label>Is_Newly_Overdue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Reminder_Due</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Newly_Overdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsNewlyOverdue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
