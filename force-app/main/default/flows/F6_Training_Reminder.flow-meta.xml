            </connector>
            <label>Newly Overdue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Reminder_Due</name>
        <label>Is_Reminder_Due</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Reminder</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fReminderDue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder_Email</targetReference>
            </connector>
            <label>Send Reminder</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fIsNewlyOverdue</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!$Record.Due_Date__c})),
    {!$Record.Due_Date__c} &lt; TODAY(),
    TEXT({!$Record.Status__c}) &lt;&gt; &quot;Overdue&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fReminderDue</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    ISBLANK({!$Record.Last_Reminder_Date__c}),
    TODAY() - {!$Record.Last_Reminder_Date__c} &gt;= 3
)</expression>
    </formulas>
    <formulas>
        <name>fSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Training reminder: &quot; &amp; {!$Record.Course__r.Name}</expression>
    </formulas>
