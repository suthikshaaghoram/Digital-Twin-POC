    <environments>Default</environments>
    <formulas>
        <name>fBurnoutCrossed</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!$Record.Burnout_Score__c})),
  {!$Record.Burnout_Score__c} &gt;= 80,
  OR(
    ISBLANK({!$Record__Prior.Burnout_Score__c}),
    {!$Record__Prior.Burnout_Score__c} &lt; 80
  )
)</expression>
    </formulas>
    <formulas>
        <name>fDueIn14Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 14</expression>
    </formulas>
    <formulas>
        <name>fDueIn2Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <formulas>
        <name>fPromotionCrossed</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!$Record.Promotion_Score__c})),
  {!$Record.Promotion_Score__c} &gt;= 90,
  OR(
    ISBLANK({!$Record__Prior.Promotion_Score__c}),
    {!$Record__Prior.Promotion_Score__c} &lt; 90
  )
)</expression>
    </formulas>
