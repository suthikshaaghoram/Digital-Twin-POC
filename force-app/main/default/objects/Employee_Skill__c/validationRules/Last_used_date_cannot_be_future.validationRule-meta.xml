<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Last_used_date_cannot_be_future</fullName>
    <active>true</active>
    <errorConditionFormula>Last_Used_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Last_Used_Date__c</errorDisplayField>
    <errorMessage>Last used date cannot be in future</errorMessage>
</ValidationRule>
