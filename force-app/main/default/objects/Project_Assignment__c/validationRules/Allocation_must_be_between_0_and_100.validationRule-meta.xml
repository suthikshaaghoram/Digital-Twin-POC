<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Allocation_must_be_between_0_and_100</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Allocation_Percent__c &lt; 0,
    Allocation_Percent__c &gt; 100
)</errorConditionFormula>
    <errorMessage>Allocation must be between 0 and 100%</errorMessage>
</ValidationRule>
